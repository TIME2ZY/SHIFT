# Copy to .env (gitignored). Loaded automatically by `npm start`.
# Shell/CI environment variables always win over this file.
# Everything is optional — defaults work out of the box.

# ── Common (what most people actually set) ───────────────────

# Shared HTTP(S) proxy for ALL CLI children (Codex / OpenCode / Grok / …).
# INVOKE_CLI_PROXY=http://127.0.0.1:7892

# Isolate Codex CLI cache from the Codex desktop app (~/.codex).
# INVOKE_CODEX_HOME=C:\Users\you\.codex-cli

# Grok API key for headless auth (or run `grok login` instead).
# XAI_API_KEY=

# HTTP listen port (default: 8787)
# PORT=8787

# ── Occasional ───────────────────────────────────────────────

# Grok-only proxy override (only if different from INVOKE_CLI_PROXY).
# GROK_PROXY=http://127.0.0.1:7892

# Windows: preferred PowerShell 7 path for provider tool shells.
# SHIFT_PWSH_PATH=C:\Program Files\PowerShell\7\pwsh.exe

# Online storage is SQLite-only. Non-sqlite SHIFT_STORAGE_MODE values are rejected.
# SQLite fails closed unless SHIFT_MEMORY_DB points to an activated clean epoch.
# Create the default database once with:
# npm run prepare:storage:epoch -- --db data/runtime/shift.sqlite
# SHIFT_STORAGE_MODE=sqlite
# SHIFT_MEMORY_DB=data/runtime/shift.sqlite
# SQLite canonical audit archive (independent from the authoritative database)
# SHIFT_AUDIT_TRANSCRIPT=on
# Kept separate from legacy data/runtime/transcripts so cleanup cannot mix generations.
# SHIFT_AUDIT_TRANSCRIPT_DIR=data/runtime/audit-transcripts

# Legacy Memory compatibility switches (both default to off).
# Re-enable heuristic suggestion creation while validating the MCP-only write path.
# SHIFT_MEMORY_SUGGESTIONS_ENABLED=1
# Re-enable fenced ```memory block writes for providers without memory_write support.
# SHIFT_MEMORY_FENCED_BLOCKS_ENABLED=1
# Embedding/vector recall is opt-in. FTS remains available when disabled or unhealthy.
SHIFT_EMBEDDING_ENABLED=false
SHIFT_EMBEDDING_PROVIDER=disabled
SHIFT_EMBEDDING_MODEL=
SHIFT_EMBEDDING_DIMENSIONS=
SHIFT_EMBEDDING_BATCH_SIZE=16
SHIFT_EMBEDDING_TIMEOUT_MS=5000
SHIFT_EMBEDDING_BASE_URL=
# Optional bearer token for an OpenAI-compatible /embeddings endpoint.
SHIFT_EMBEDDING_API_KEY=
