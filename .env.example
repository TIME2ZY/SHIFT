# Copy to .env (gitignored). Loaded automatically by `npm start`.
# Shell/CI environment variables always win over this file.
# Everything is optional — defaults work out of the box.

# ── Common (what most people actually set) ───────────────────

# Shared HTTP(S) proxy for ALL CLI children (Codex / OpenCode / Grok / …).
# INVOKE_CLI_PROXY=http://127.0.0.1:7892

# Isolate Codex CLI cache from the Codex desktop app (~/.codex).
# INVOKE_CODEX_HOME=C:\Users\you\.codex-cli

# Log resolved CLI proxy configuration at provider startup (default: off).
# INVOKE_CLI_PROXY_LOG=1

# HTTP listen port (default: 8787)
# PORT=8787

# SHIFT application root. Runtime data is stored under SHIFT_HOME/data.
# Defaults to ~/.shift. Use an absolute path; forward slashes are recommended on Windows.
# SHIFT_HOME=C:/Users/you/.shift

# ── Occasional ───────────────────────────────────────────────

# Grok-only proxy override (only if different from INVOKE_CLI_PROXY).
# GROK_PROXY=http://127.0.0.1:7892

# Windows: preferred PowerShell 7 path for provider tool shells.
# SHIFT_PWSH_PATH=C:\Program Files\PowerShell\7\pwsh.exe

# Online storage is SQLite-only. Non-sqlite SHIFT_STORAGE_MODE values are rejected.
# SQLite fails closed unless SHIFT_HOME/data/shift.sqlite is an activated clean epoch.
# New install: npm run storage:init-home
# Existing repository data: npm run storage:migrate-home
# SHIFT_STORAGE_MODE=sqlite

# Bearer token protecting every /api route. When unset, a random token is minted at
# startup and injected into the served index.html, so the browser works without
# configuration. Set it only when driving the API from a script or a second client.
# SHIFT_UI_TOKEN=

# Embedding/vector recall is opt-in. FTS remains available when disabled or unhealthy.
SHIFT_EMBEDDING_ENABLED=false
SHIFT_EMBEDDING_PROVIDER=disabled
SHIFT_EMBEDDING_MODEL=
SHIFT_EMBEDDING_DIMENSIONS=
SHIFT_EMBEDDING_BATCH_SIZE=16
SHIFT_EMBEDDING_TIMEOUT_MS=5000
SHIFT_EMBEDDING_BASE_URL=
# Optional bearer token for an OpenAI-compatible /embeddings endpoint.
SHIFT_EMBEDDING_API_KEY=

# Recall: fts (default, keyword) or hybrid (FTS + vector, needs embeddings above).
# SHIFT_RECALL_MODE=fts

# ── Tuning (leave commented to keep the documented defaults) ─

# Collaboration ───────────────────────────────────────────────
# handoff strictness: soft | balanced | strict (default: balanced)
# SHIFT_HANDOFF_POLICY=balanced
# Max times an identical plan hash may be accepted per task (default: 3)
# SHIFT_MAX_IDENTICAL_PLANS=3
# Max @agent handoff chain depth per turn (default: 15)
# MAX_A2A_DEPTH=15

# Lifetime of an agent callback token used by the MCP bridge (default: 30 min)
# SHIFT_TOKEN_TTL_MS=1800000

# Memory injected into agent prompts ──────────────────────────
# Total budget for queried memory, per turn (default: 4000, bounds 256–100000)
# SHIFT_RETRIEVE_BUDGET_CHARS=4000
# Same, for a2a handoff turns which carry less context (default: 2000)
# SHIFT_RETRIEVE_A2A_BUDGET_CHARS=2000
# Cap reserved for always-on memory inside that budget (default: 1000)
# SHIFT_RETRIEVE_ALWAYS_ON_BUDGET_CHARS=1000
# Recent / related memories attached per turn (defaults: 6 / 5, range 1–100)
# SHIFT_RETRIEVE_RECENT_LIMIT=6
# SHIFT_RETRIEVE_RELATED_LIMIT=5
# Per-query recall hit caps (defaults: 8 memories / 4 messages, range 1–100)
# SHIFT_SEARCH_MEMORY_QUOTA=8
# SHIFT_SEARCH_MESSAGE_QUOTA=4
# Include assistant thinking turns in recall (default: off)
# SHIFT_SEARCH_INCLUDE_THINKING=0
# Log memory pipeline metrics to stdout (default: off)
# SHIFT_MEMORY_METRICS_LOG=1

# Observability export (all inert until SHIFT_OBSERVABILITY_EXPORT_ENDPOINT is set)
# SHIFT_OBSERVABILITY_EXPORT_ENDPOINT=
# shift-webhook | sentry-envelope (default: shift-webhook)
# SHIFT_OBSERVABILITY_EXPORT_PROTOCOL=shift-webhook
# Min 10s; below that the export loop refuses to start (default: 60s)
# SHIFT_OBSERVABILITY_EXPORT_INTERVAL_MS=60000
# SHIFT_OBSERVABILITY_EXPORT_TIMEOUT_MS=5000
# SHIFT_OBSERVABILITY_EXPORT_CLOSE_TIMEOUT_MS=
